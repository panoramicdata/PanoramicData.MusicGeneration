@page "/song"
@implements IAsyncDisposable
@inject SoundFontBankService Banks
@inject IJSRuntime JS
@using PanoramicData.MusicGeneration.SoundFonts

<h1>Build a song</h1>
<p class="lead">Shape an idea, give the harmony direction and choose how the ensemble responds. Each control explains the musical decision it changes.</p>

<div class="studio-tabs" role="tablist" aria-label="Song controls">
	@for (var i = 0; i < Tabs.Length; i++)
	{
		var index = i;
		var tab = Tabs[index];
		<button type="button" @ref="tabButtons[index]" id="@("tab-" + tab)" role="tab" aria-controls="@("panel-" + tab)"
			aria-selected="@(activeTab == tab ? "true" : "false")" tabindex="@(activeTab == tab ? 0 : -1)"
			class="@(activeTab == tab ? "selected" : "secondary")" @onclick="() => activeTab = tab" @onkeydown="e => TabKeyAsync(e, index)">@TabTitle(tab)</button>
	}
</div>

<div class="studio-actions card">
	<button @onclick="GenerateAsync" disabled="@busy">@(busy ? "Working…" : "Generate / render changes")</button>
	<button class="secondary" @onclick="RandomiseAsync" disabled="@busy">New seed</button>
	<button class="secondary" @onclick="NewMelodyAsync" disabled="@busy">New melody</button>
	@if (dirty && !busy) { <span class="note">Settings changed. Generate to hear them.</span> }
	@if (busy) { <div class="render-status" role="status" aria-live="polite"><strong>@status</strong><progress aria-label="@status"></progress></div> }
</div>

<section class="card composition-panel" aria-label="Composition settings" hidden="@(activeTab == "Instruments")">
	<fieldset disabled="@busy">
		<div class="control-heading" aria-hidden="true"><span>Setting</span><span>Control</span><span>What it changes</span></div>
		<div id="panel-Song" role="tabpanel" aria-labelledby="tab-Song" hidden="@(activeTab != "Song")">
			<h2>Song</h2>
			<StudioControl Id="song-title" Title="Song title" Detail="The name used for local saves and downloaded files."><input id="song-title" aria-describedby="song-title-help" @bind="title" maxlength="100" /></StudioControl>
			<StudioControl Id="song-genre" Title="Genre" Detail="Loads a suggested ensemble, beat, tempo and progression. Each remains editable."><select id="song-genre" aria-describedby="song-genre-help" @bind="genre" @bind:after="ApplyGenre">@foreach (var value in Enum.GetValues<MusicGenre>()) { <option value="@value">@GenreName(value)</option> }</select></StudioControl>
			<StudioControl Id="song-tempo" Title="Tempo" Detail="The underlying quarter-note pulse. Phrase expression shapes the lead around this pulse."><input id="song-tempo" aria-describedby="song-tempo-help" type="number" min="40" max="220" @bind="tempo" @bind:after="MarkDirty" /><span>bpm</span></StudioControl>
			<StudioControl Id="song-key" Title="Key" Detail="The tonal home for named progressions and melodic material. Custom chord symbols keep their written pitches."><select id="song-key" aria-describedby="song-key-help" @bind="key" @bind:after="MarkDirty">@for (var i = 0; i < 12; i++) { <option value="@i">@(Pitch.NameOf(60 + i)[..^1])</option> }</select></StudioControl>
			<StudioControl Id="song-minor" Title="Minor key" Detail="Uses the minor version of supported progressions and a minor scale for melodic passing notes."><input id="song-minor" aria-describedby="song-minor-help" type="checkbox" @bind="minor" @bind:after="MarkDirty" /></StudioControl>
			<StudioControl Id="song-length" Title="Length ceiling" Detail="Reserves an outro and finishes complete sections early when needed. Maximum five minutes."><input id="song-length" aria-describedby="song-length-help" type="range" min="6" max="300" step="2" @bind="seconds" @bind:after="MarkDirty" /><output>@(TimeSpan.FromSeconds(seconds).ToString(@"m\:ss"))</output></StudioControl>
			<details class="advanced-settings"><summary>Reproducibility and seeds</summary>
				<StudioControl Id="song-seed" Title="Seed" Detail="Reproduces composition decisions within this composer version. New seed makes a new arrangement."><input id="song-seed" aria-describedby="song-seed-help" type="number" @bind="seed" @bind:after="MarkDirty" /></StudioControl>
				<StudioControl Id="melody-seed" Title="Melody seed" Detail="Blank follows the song seed. A fixed number retains the underlying melodic idea; New melody changes it while keeping harmony and rhythm parts."><input id="melody-seed" aria-describedby="melody-seed-help" type="number" @bind="melodySeed" @bind:after="MarkDirty" placeholder="Auto" /></StudioControl>
			</details>
		</div>
		<div id="panel-Harmony" role="tabpanel" aria-labelledby="tab-Harmony" hidden="@(activeTab != "Harmony")">
			<h2>Harmony &amp; melody</h2>
			<StudioControl Id="harmony-progression" Title="Chord progression" Detail="The underlying chord sequence. Every section derives from this material; the four-chord option is I–V–vi–IV."><select id="harmony-progression" aria-describedby="harmony-progression-help" @bind="progression" @bind:after="MarkDirty">@foreach (var name in ChordProgressions.Names) { <option value="@name">@ProgressionLabel(name)</option> }</select></StudioControl>
			@if (progression == "Custom") { <StudioControl Id="harmony-symbols" Title="Chord symbols" Detail="Major, minor, sevenths, diminished, augmented and suspended chords. Colour can add approaches; set colour and progression variation to zero for the literal sequence."><input id="harmony-symbols" aria-describedby="harmony-symbols-help" @bind="customChords" @bind:after="MarkDirty" placeholder="Cmaj7, Am7, Dm7, G7" maxlength="256" /></StudioControl> }
			<p class="chord-preview" aria-label="Selected chords">@ChordPreview</p>
			<StudioControl Id="harmony-movement" Title="Harmonic movement" Detail="Varies how long chords last: linger on one harmony, then move through shorter changes towards an arrival. Zero uses one chord per bar."><input id="harmony-movement" aria-describedby="harmony-movement-help" type="range" min="0" max="1" step="0.05" @bind="harmonicMovement" @bind:after="MarkDirty" /><output>@harmonicMovement.ToString("P0")</output></StudioControl>
			<StudioControl Id="harmony-colour" Title="Chromatic colour" Detail="Offers dominant approaches, borrowed minor-subdominant colour and short chromatic melodic approaches at suitable positions. These lead towards a target, rather than adding unrelated accidentals."><input id="harmony-colour" aria-describedby="harmony-colour-help" type="range" min="0" max="1" step="0.05" @bind="chromaticColour" @bind:after="MarkDirty" /><output>@chromaticColour.ToString("P0")</output></StudioControl>
			<StudioControl Id="harmony-variation" Title="Progression variation" Detail="Offers related substitutions and seventh-chord colours at selected phrase positions. This changes chord choices, while harmonic movement changes their duration."><input id="harmony-variation" aria-describedby="harmony-variation-help" type="range" min="0" max="1" step="0.05" @bind="progressionVariation" @bind:after="MarkDirty" /><output>@progressionVariation.ToString("P0")</output></StudioControl>
			<StudioControl Id="melody-development" Title="Phrase development" Detail="Later two-bar phrases can change their answer, fragment or invert the idea, and close. Zero repeats the underlying idea."><input id="melody-development" aria-describedby="melody-development-help" type="range" min="0" max="1" step="0.05" @bind="variation" @bind:after="MarkDirty" /><output>@variation.ToString("P0")</output></StudioControl>
		</div>
		<div id="panel-Expression" role="tabpanel" aria-labelledby="tab-Expression" hidden="@(activeTab != "Expression")">
			<h2>Groove &amp; expression</h2>
			<StudioControl Id="drum-variation" Title="Drum variation" Detail="Varies two-bar drum gestures with quiet snare ghosts, kick anticipations, hat pickups and cymbal choices. Keeps the selected groove recognisable."><input id="drum-variation" aria-describedby="drum-variation-help" type="range" min="0" max="1" step="0.05" @bind="drumVariation" @bind:after="MarkDirty" /><output>@drumVariation.ToString("P0")</output></StudioControl>
			<StudioControl Id="drum-fills" Title="Drum fills" Detail="Controls the chance and scope of fills at four-bar and section boundaries: short pickups through snare/tom runs and triplets. Hats leave room for fills; zero retains the earlier tiny verse pickup."><input id="drum-fills" aria-describedby="drum-fills-help" type="range" min="0" max="1" step="0.05" @bind="drumFills" @bind:after="MarkDirty" /><output>@drumFills.ToString("P0")</output></StudioControl>
			<StudioControl Id="drum-humanity" Title="Drum humanity" Detail="Shapes accents, ghost-note contrast and a four-bar dynamic arc. Snare hits sit slightly behind the beat, hats slightly ahead; kick pulse anchors stay fixed. Zero keeps the timing grid."><input id="drum-humanity" aria-describedby="drum-humanity-help" type="range" min="0" max="1" step="0.05" @bind="drumHumanity" @bind:after="MarkDirty" /><output>@drumHumanity.ToString("P0")</output></StudioControl>
			<StudioControl Id="groove-beat" Title="Beat / rhythm" Detail="Chooses the accompaniment and percussion vocabulary independently of the genre's starting ensemble."><select id="groove-beat" aria-describedby="groove-beat-help" @bind="beat" @bind:after="MarkDirty">@foreach (var value in Enum.GetValues<MusicBeat>()) { <option value="@value">@GenreName(value)</option> }</select></StudioControl>
			<StudioControl Id="groove-swing" Title="Swing" Detail="Delays selected offbeats by this fraction of a beat. Zero keeps their straight positions."><input id="groove-swing" aria-describedby="groove-swing-help" type="range" min="0" max="0.4" step="0.01" @bind="swing" @bind:after="MarkDirty" /><output>@swing.ToString("P0")</output></StudioControl>
			<StudioControl Id="groove-expression" Title="Phrase expression" Detail="Connects melodic notes across bar/chord boundaries, offers prepared suspensions and accented neighbours, and shapes lead timing and dynamics across each phrase. Answer parts seek actual foreground rests."><input id="groove-expression" aria-describedby="groove-expression-help" type="range" min="0" max="1" step="0.05" @bind="phraseExpression" @bind:after="MarkDirty" /><output>@phraseExpression.ToString("P0")</output></StudioControl>
			<StudioControl Id="groove-accompaniment" Title="Accompaniment variation" Detail="Leaves selected gaps in comping/arpeggios and offers bass approaches towards the next harmony. Supports the phrase without continuously filling every subdivision."><input id="groove-accompaniment" aria-describedby="groove-accompaniment-help" type="range" min="0" max="1" step="0.05" @bind="accompanimentVariation" @bind:after="MarkDirty" /><output>@accompanimentVariation.ToString("P0")</output></StudioControl>
		</div>
		<div id="panel-Structure" role="tabpanel" aria-labelledby="tab-Structure" hidden="@(activeTab != "Structure")">
			<h2>Structure</h2>
			<StudioControl Id="structure-sections" Title="Verse / chorus sections" Detail="Four two-bar phrases per verse/chorus. Intro and bridge/break are four bars; longer songs place the break later. Very short songs omit sections that cannot fit."><input id="structure-sections" aria-describedby="structure-sections-help" type="checkbox" @bind="sections" @bind:after="MarkDirty" /></StudioControl>
			<StudioControl Id="structure-contrast" Title="Section contrast" Detail="Derives related verse, bridge and intro variants from your selected cycle. Zero shares the same cycle. Named section cadences follow the selected key."><input id="structure-contrast" aria-describedby="structure-contrast-help" type="range" min="0" max="1" step="0.05" @bind="sectionContrast" @bind:after="MarkDirty" /><output>@sectionContrast.ToString("P0")</output></StudioControl>
			<StudioControl Id="structure-intro" Title="Intro variation" Detail="Varies the opening teaser and accompaniment build within the four-bar intro."><input id="structure-intro" aria-describedby="structure-intro-help" type="range" min="0" max="1" step="0.05" @bind="introVariation" @bind:after="MarkDirty" /><output>@introVariation.ToString("P0")</output></StudioControl>
			<p class="note">Ending weights are relative and normalised together. Set the others to zero to force one ending. Every ending reserves an outro and release.</p>
			<StudioControl Id="ending-fade" Title="Repeat and fade" Detail="Repeats the closing harmony and fades to silence."><input id="ending-fade" aria-describedby="ending-fade-help" type="number" min="0" max="1" step="0.05" @bind="fadeWeight" @bind:after="MarkDirty" /></StudioControl>
			<StudioControl Id="ending-cadence" Title="Cadence and hold" Detail="A dominant-to-tonic arrival followed by a held ending."><input id="ending-cadence" aria-describedby="ending-cadence-help" type="number" min="0" max="1" step="0.05" @bind="cadenceWeight" @bind:after="MarkDirty" /></StudioControl>
			<StudioControl Id="ending-tag" Title="Closing tag" Detail="Repeats a short closing idea before landing on tonic."><input id="ending-tag" aria-describedby="ending-tag-help" type="number" min="0" max="1" step="0.05" @bind="tagWeight" @bind:after="MarkDirty" /></StudioControl>
			<StudioControl Id="ending-stop" Title="Coordinated stop" Detail="Finishes with a planned final hit and a short release."><input id="ending-stop" aria-describedby="ending-stop-help" type="number" min="0" max="1" step="0.05" @bind="stopWeight" @bind:after="MarkDirty" /></StudioControl>
		</div>
	</fieldset>
</section>

<section class="card layer-panel" aria-label="Instrument layers" id="panel-Instruments" role="tabpanel" aria-labelledby="tab-Instruments" hidden="@(activeTab != "Instruments")">
	<h2>Instruments &amp; mix <span class="note">@layers.Count / 24</span></h2>
	<p class="note">Add any available instrument, even several copies of the same one. Choose what each layer plays. Mute, gain and register edits take effect on the next render.</p>
	<fieldset disabled="@busy">
		@foreach (var layer in layers)
		{
			<div class="layer-row" @key="layer.Id">
				<label>On <input type="checkbox" @bind="layer.Enabled" @bind:after="MarkDirty" /></label>
				<label>Name <input @bind="layer.Name" @bind:after="MarkDirty" maxlength="100" /></label>
				<label>Part <select @bind="layer.Pattern" @bind:after="() => ChangePattern(layer)">@foreach (var pattern in Enum.GetValues<LayerPattern>()) { <option value="@pattern">@pattern</option> }</select></label>
				<label>Instrument <select @bind="layer.Preset" @bind:after="MarkDirty">@foreach (var preset in PresetsFor(layer)) { <option value="@(preset.Bank * 128 + preset.Program)">@preset.Name (@preset.Bank:@preset.Program)</option> }</select></label>
				<label>Level <input type="range" min="0" max="1.5" step="0.025" @bind="layer.Gain" @bind:after="MarkDirty" /> @layer.Gain.ToString("0.###")</label>
				<label>Strength <input type="number" min="1" max="127" @bind="layer.Velocity" @bind:after="MarkDirty" /></label>
				<label>Octave <input type="number" min="-2" max="2" @bind="layer.Octave" @bind:after="MarkDirty" /></label>
				@if (layer.Bank == 0 && layer.Program <= 7 && layer.Pattern is LayerPattern.Melody or LayerPattern.Arpeggio)
				{
					<label>Two-hand piano <input type="checkbox" @bind="layer.PianoTwoHands" @bind:after="MarkDirty" /><span class="note">Quiet left hand and treble intervals; existing piano accompaniment supplies the left hand when present.</span></label>
				}
				<div class="layer-actions"><button class="secondary" @onclick="() => Duplicate(layer)">Duplicate</button><button class="secondary" @onclick="() => Remove(layer)" disabled="@(layers.Count == 1)">Remove</button></div>
				<details class="presence-settings"><summary>Section presence probabilities</summary>
					<p class="note">One seeded decision for each whole section. 100% always participates; 0% omits the part. Normal rests and the final release still apply. Occurrence overrides take precedence.</p>
					<div class="control-row">
						<label>Intro presence <input type="range" min="0" max="1" step="0.05" @bind="layer.Presence.Intro" @bind:after="MarkDirty" /> @layer.Presence.Intro.ToString("P0")</label>
						<label>Verse presence <input type="range" min="0" max="1" step="0.05" @bind="layer.Presence.Verse" @bind:after="MarkDirty" /> @layer.Presence.Verse.ToString("P0")</label>
						<label>Chorus presence <input type="range" min="0" max="1" step="0.05" @bind="layer.Presence.Chorus" @bind:after="MarkDirty" /> @layer.Presence.Chorus.ToString("P0")</label>
						<label>Bridge presence <input type="range" min="0" max="1" step="0.05" @bind="layer.Presence.Bridge" @bind:after="MarkDirty" /> @layer.Presence.Bridge.ToString("P0")</label>
						<label>Outro presence <input type="range" min="0" max="1" step="0.05" @bind="layer.Presence.Outro" @bind:after="MarkDirty" /> @layer.Presence.Outro.ToString("P0")</label>
					</div>
					@foreach (var item in layer.Presence.Overrides)
					{
						<div class="control-row presence-override" @key="item">
							<label>Section <select @bind="item.Kind" @bind:after="MarkDirty">@foreach (var kind in Enum.GetValues<SectionKind>()) { <option value="@kind">@kind</option> }</select></label>
							<label>Occurrence <input type="number" min="1" max="100" @bind="item.Occurrence" @bind:after="MarkDirty" /></label>
							<label>Presence <input type="range" min="0" max="1" step="0.05" @bind="item.Probability" @bind:after="MarkDirty" /> @item.Probability.ToString("P0")</label>
							<button class="secondary" @onclick="() => { layer.Presence.Overrides.Remove(item); MarkDirty(); }">Remove override</button>
						</div>
					}
					<button class="secondary" disabled="@(layer.Presence.Overrides.Count >= 100)" @onclick="() => { layer.Presence.Overrides.Add(new()); MarkDirty(); }">Add occurrence override</button>
				</details>
			</div>
		}
		<button class="secondary" @onclick="AddLayer" disabled="@(layers.Count >= 24)">Add instrument layer</button>
	</fieldset>
</section>


@if (error is not null) { <p role="alert" class="error">@error</p> }
@if (notice is not null) { <p role="status">@notice</p> }

@if (rendered is not null && audioUrl is not null)
{
	<section aria-label="Rendered arrangement">
		<p class="note performance-summary">@rendered.Song.Duration.TotalSeconds.ToString("0.00") s performed within @score!.Settings.Seconds s ceiling · @rendered.Song.SampleRate.ToString("N0") Hz · @score.Tracks.Count(t => t.Instrument.Enabled) enabled layers · ending: @(score.Ending?.Kind.ToString() ?? "Legacy") · rendered in @renderSeconds.ToString("0.0") s. @(!dirty ? "Current settings are rendered." : "Player still contains the previous render.")</p>
		<label>Visualizer <select @bind="visualizer" disabled="@busy"><option value="piano">Piano roll</option><option value="spectrogram">Spectrogram</option></select></label>
		<MusicPlayer Src="@audioUrl" Notes="rendered.Song.Notes" Sections="rendered.Song.Sections" Chords="score.Chords" LayerNames="LayerNames" ShowSpectrogram="@(visualizer == "spectrogram")" />
		<div class="control-row"><button @onclick="DownloadMp3Async" disabled="@busy">Download MP3</button><button class="secondary" @onclick="DownloadWavAsync" disabled="@busy">Download WAV</button></div>
		<p class="note">MP3 encoding runs locally with LAME / lamejs (LGPL). <a href="vendor/lamejs/COPYING.LESSER">Licence</a> · <a href="vendor/lamejs/source.zip">Corresponding source</a>. This page never uploads your songs.</p>
		<details><summary>Score, harmony and rendering details</summary>
			<p>Composer @score.ComposerVersion · melody seed @(score.Settings.MelodySeed ?? score.Settings.Seed). Written notes are saved for exact score replay; changing settings and generating uses the current composer.</p>
			<div class="table-scroll"><table aria-label="Section harmony"><thead><tr><th>Section</th><th>Performed chords</th></tr></thead><tbody>
				@foreach (var section in score.Sections) { <tr><td>@section.Kind</td><td>@string.Join(" → ", score.Chords.Where(c => c.StartSeconds >= section.StartSeconds && c.StartSeconds < section.EndSeconds).Select(c => c.Symbol))</td></tr> }
			</tbody></table></div>
			<p>Complete verses and choruses have four two-bar phrases. The arranger reserves the outro, adds complete sections, then finishes early when another section will not fit. Very short requests can contain just an outro.</p>
			<div class="table-scroll"><table aria-label="Section participation"><thead><tr><th>Section</th><th>Instrument</th><th>Chance</th><th>Decision</th></tr></thead><tbody>
				@foreach (var choice in score.Participation) { <tr><td>@score.Sections[choice.SectionIndex].Kind @choice.Occurrence</td><td>@LayerNames[choice.LayerId]</td><td>@choice.Probability.ToString("P0")</td><td>@(choice.Present ? "Present" : "Omitted")</td></tr> }
			</tbody></table></div>
			<div class="table-scroll"><table aria-label="Chord timeline"><thead><tr><th>Start</th><th>Chord</th><th>Chord tones</th></tr></thead><tbody>@foreach (var chord in score.Chords) { <tr><td>@chord.StartSeconds.ToString("0.00") s</td><td>@chord.Symbol</td><td>@string.Join(" · ", chord.Intervals.Select(i => Pitch.NameOf(48 + chord.Root + i)))</td></tr> }</tbody></table></div>
			<pre>@System.Text.Json.JsonSerializer.Serialize(rendered.Metadata, StudioJsonContext.Default.LayeredRenderMetadata)</pre>
		</details>
	</section>
}

<section class="card library-panel" aria-label="Local song library">
	<h2>Your browser song library</h2>
	<p class="note">Save the written notes, instrument layers and settings, then reopen and re-render them. Audio is not stored in the library. This storage belongs to this browser and site; clearing site data removes it. Export a song file for a portable backup.</p>
	<div class="control-row">
		<button @onclick="SaveAsync" disabled="@(busy || score is null || dirty)">Save song locally</button>
		<button class="secondary" @onclick="ExportSongAsync" disabled="@(busy || score is null || dirty)">Export song JSON</button>
		<button class="secondary" @onclick="ExportSettingsAsync" disabled="@busy">Export settings JSON</button>
		<label>Import settings / song <InputFile accept="application/json,.json" OnChange="ImportAsync" disabled="@busy" /></label>
	</div>
	@if (saved.Count == 0) { <p>No songs saved in this browser yet.</p> }
	@foreach (var item in saved)
	{
		<div class="saved-row"><strong>@item.Title</strong><span class="note">@item.SavedUtc</span><button class="secondary" @onclick="() => OpenAsync(item.Id)" disabled="@busy">Open</button><button class="secondary" @onclick="() => DeleteAsync(item.Id)" disabled="@busy">Delete</button></div>
	}
</section>

<p class="note">Need the original procedural generator or a caller-supplied SF2 bank? <a href="song/legacy">Open the original song page</a>. For playing strength and attack, try <a href="soundfonts">the SoundFont keyboard lesson</a>.</p>
