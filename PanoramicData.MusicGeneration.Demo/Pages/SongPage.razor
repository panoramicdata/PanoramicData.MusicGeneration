@page "/song"
@implements IAsyncDisposable
@inject IJSRuntime JS

<h1>Build a song</h1>
<p class="lead">
	Choose a seed and which parts play. The piano roll shows every note the generator wrote, coloured by part; the player plays exactly those notes.
</p>

<div class="card">
	<div class="row">
		<label>Seed <input type="text" @bind="seedText" style="width:7rem" /></label>
		<label>Length <strong>@seconds</strong> s <input type="range" min="6" max="30" step="2" @bind="seconds" @bind:event="oninput" /></label>
		<button @onclick="GenerateAsync" disabled="@busy">Generate</button>
		<button class="secondary" @onclick="RandomSeedAsync" disabled="@busy">Random seed</button>
	</div>
	<div class="row">
		<label><input type="checkbox" @bind="pad" /> pad</label>
		<label><input type="checkbox" @bind="bass" /> bass</label>
		<label><input type="checkbox" @bind="melody" /> melody</label>
		<label><input type="checkbox" @bind="drums" /> drums</label>
		<label>Melody from <strong>@Pitch.NameOf(melodyLow)</strong> to <strong>@Pitch.NameOf(melodyLow + melodySpan)</strong>
			<input type="range" min="48" max="72" step="1" @bind="melodyLow" @bind:event="oninput" />
			<input type="range" min="12" max="36" step="1" @bind="melodySpan" @bind:event="oninput" />
		</label>
	</div>
	@if (error is not null)
	{
		<p style="color:var(--bad)">@error</p>
	}
</div>

@if (song is not null)
{
	<p class="note" style="margin-top:1rem">Rendered @song.Duration.TotalSeconds.ToString("0") s of audio at 11,025 Hz in @renderSeconds.ToString("0.0") s, in your browser, using the browser's own sine function (SongStyle.UsePlatformSine) because the library's bit-exact sine is much slower in WebAssembly. The notes are identical either way; only the last bit of each sample can differ.</p>
	<div class="grid" style="margin-top:1rem">
		<div class="card"><div class="stat">@song.Info.TempoBpm</div><p>beats per minute (one beat lasts @((60.0 / song.Info.TempoBpm).ToString("0.000")) s)</p></div>
		<div class="card"><div class="stat">@Pitch.NameOf(song.Info.RootMidi)</div><p>root note, @song.Info.ScaleName scale</p></div>
		<div class="card"><div class="stat">@song.Info.DetuneCents</div><p>cents from concert pitch (A4 = @song.Info.ReferenceHz.ToString("0.0") Hz)</p></div>
		<div class="card"><div class="stat">@song.Notes.Count</div><p>notes and drum hits</p></div>
	</div>

	@if (audioUrl is not null)
	{
		<audio controls src="@audioUrl" style="width:100%;margin:1rem 0"></audio>
	}

	<canvas id="roll" width="1000" height="360"></canvas>
	<p class="note">
		<span style="color:#9b8cff">&#9632;</span> pad &nbsp; <span style="color:#4cc2ff">&#9632;</span> bass &nbsp; <span style="color:#7cf0b2">&#9632;</span> melody &nbsp;
		<span style="color:#ff8f6b">&#9632;</span> kick &nbsp; <span style="color:#ffd666">&#9632;</span> snare &nbsp; <span style="color:#c9d3ea">&#9632;</span> hi-hat.
		Horizontal axis: time. Vertical axis: pitch, one row per semitone, with each C labelled.
	</p>
}

<h2>How each part is made</h2>
<div class="steps">
	<div class="step"><strong>Pad.</strong> One chord per bar: a triad (scale degrees 0, 2 and 4 above a random degree) on the octave above the bass, optionally inverted by lifting the lowest notes one octave.
		Slow decay, only the first 3 harmonics: a soft background.</div>
	<div class="step"><strong>Bass.</strong> On each beat there is a 65% chance of a bass note, usually the chord's root and sometimes its fifth (7 semitones up).
		Low (the key's root sits between C2 and B2), few harmonics, quick decay.</div>
	<div class="step"><strong>Melody.</strong> A random walk: after each note the scale degree moves by &minus;3 to +3 steps, clamped to the chosen range, with note lengths of half, one or one and a half beats and a 15% chance of a rest.
		Six harmonics and a gentle vibrato: the frequency is multiplied by 1 + 0.004 sin(2&pi; &middot; v &middot; t) with v between 4.5 and 6.5 Hz.</div>
	<div class="step"><strong>Kick.</strong> A single sine whose frequency falls quickly, f(t) = f<sub>0</sub> + 110 e<sup>&minus;28t</sup>, with amplitude 0.5 e<sup>&minus;14t</sup>: the thump of a drum skin relaxing.</div>
	<div class="step"><strong>Snare and hi-hat.</strong> White noise passed through a first-difference filter, y<sub>n</sub> = w<sub>n</sub> &minus; w<sub>n&minus;1</sub>, which cuts the low frequencies,
		times a fast decay e<sup>&minus;6u</sup> over the burst. The snare is longer and louder than the hat.</div>
	<div class="step"><strong>Envelope.</strong> Every tone is multiplied by attack &times; decay &times; release: a 1/120 s linear rise (so there is no click), an exponential decay e<sup>&minus;d&middot;t/length</sup>, and a 1/40 s fade at the end.</div>
	<div class="step"><strong>Mixing.</strong> The parts are summed and the whole song is scaled so that its loudest sample is exactly 0.9.</div>
</div>

@code {
	private IJSObjectReference? module;
	private string seedText = "42";
	private int seconds = 10;
	private double renderSeconds;
	private bool pad = true;
	private bool bass = true;
	private bool melody = true;
	private bool drums = true;
	private int melodyLow = 60;
	private int melodySpan = 24;
	private GeneratedSong? song;
	private string? audioUrl;
	private string? error;
	private bool busy;

	private async Task<IJSObjectReference> ModuleAsync() => module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/music.js");

	private async Task RandomSeedAsync()
	{
		seedText = Random.Shared.Next(1, 99999).ToString(System.Globalization.CultureInfo.InvariantCulture);
		await GenerateAsync();
	}

	private async Task GenerateAsync()
	{
		error = null;
		if (!int.TryParse(seedText, out var seed))
		{
			error = "The seed must be a whole number.";
			return;
		}

		busy = true;
		StateHasChanged();
		await Task.Yield();
		try
		{
			const int rate = 11025;
			var clock = System.Diagnostics.Stopwatch.StartNew();
			var style = new SongStyle { UsePlatformSine = true, Pad = pad, Bass = bass, Melody = melody, Drums = drums, MelodyLowMidi = melodyLow, MelodyHighMidi = melodyLow + melodySpan };
			song = SongGenerator.Generate(seed, seconds, rate, style);
			renderSeconds = clock.Elapsed.TotalSeconds;
			var js = await ModuleAsync();
			audioUrl = await js.InvokeAsync<string>("createAudioUrl", song.ToWav());

			var notes = song.Notes.SelectMany(n => new double[] { n.StartSeconds, n.DurationSeconds, n.MidiNote, (int)n.Voice }).ToArray();
			var low = Math.Min(30, melodyLow);
			var high = melodyLow + melodySpan;
			var names = Enumerable.Range(low, high - low + 1).Select(Pitch.NameOf).ToArray();
			// The canvas only exists once the results have been rendered, so render first, then draw on it.
			StateHasChanged();
			await Task.Delay(50);
			await js.InvokeVoidAsync("drawPianoRoll", "roll", notes, seconds, low, high, names);
		}
		catch (ArgumentException ex)
		{
			error = ex.Message;
		}
		finally
		{
			busy = false;
			StateHasChanged();
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await GenerateAsync();
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (module is not null)
		{
			await module.DisposeAsync();
		}
	}
}
