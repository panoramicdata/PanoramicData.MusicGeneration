@page "/song"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HttpClient Http
@using PanoramicData.MusicGeneration.SoundFonts

<h1>Build a song</h1>
<p class="lead">
	Choose a seed and which parts play. Switch between a piano roll of the generated notes and a spectrogram of the audible mix.
</p>

<div class="card">
	<div class="control-row">
		<label>Seed <input type="text" @bind="seedText" disabled="@busy" style="width:7rem" /></label>
		<label>Length <strong>@seconds</strong> s <input type="range" min="6" max="300" step="2" @bind="seconds" @bind:event="oninput" disabled="@busy" /></label>
		<button @onclick="GenerateAsync" disabled="@busy">@(busy ? "Working…" : "Generate")</button>
		<button class="secondary" @onclick="RandomSeedAsync" disabled="@busy">Random seed</button>
		<label>Composition
			<select @bind="FormMode" @bind:after="ChooseForm" disabled="@busy">
				<option value="free">Free-running</option>
				<option value="sections">Verse / chorus / bridge</option>
				<option value="through">Sections with new material each time</option>
			</select>
		</label>
	</div>
	<div class="control-row">
		@foreach (var voice in Enum.GetValues<VoiceKind>())
		{
			<div><strong>@voice</strong>
				<button class="secondary" disabled="@busy" aria-pressed="@muted.Contains(voice)" @onclick="() => ToggleMuteAsync(voice)">@(muted.Contains(voice) ? "Unmute" : "Mute")</button>
				<button class="secondary" disabled="@busy" aria-pressed="@(solo == voice)" @onclick="() => ToggleSoloAsync(voice)">Solo</button>
			</div>
		}
		<label>Melody from <strong>@Pitch.NameOf(melodyLow)</strong> to <strong>@Pitch.NameOf(melodyLow + melodySpan)</strong>
			<input type="range" min="36" max="72" step="1" @bind="melodyLow" @bind:event="oninput" disabled="@busy" />
			<input type="range" min="12" max="36" step="1" @bind="melodySpan" @bind:event="oninput" disabled="@busy" />
		</label>
	</div>
	<div class="control-row">
		<label>Sound
			<select @bind="soundMode" @bind:after="ChangeSoundAsync" disabled="@busy">
				<option value="procedural">Procedural synthesis</option>
				<option value="soundfont">SoundFont instruments</option>
			</select>
		</label>
		@if (soundMode == "soundfont")
		{
			<span>@soundFontName</span>
		}
	</div>
	@if (soundMode == "soundfont")
	{
		<p class="note">Play the same written notes with sampled instruments. GeneralUser GS by S. Christian Collins.
			<a href="soundfonts/GeneralUser-GS-LICENSE.txt" target="_blank">Bank licence</a> ·
			<a href="soundfonts/MeltySynth-LICENSE.txt" target="_blank">MeltySynth licence</a>.
			Or load your own SF2 bank (up to 64 MiB); the file stays in your browser.</p>
		<label class="soundfont-file">Your SF2 bank <InputFile OnChange="LoadSoundFontAsync" accept=".sf2" disabled="@busy" /></label>
		@if (soundFont is not null)
		{
			<div class="control-row soundfont-controls">
				<label>Pad <select @bind="padPreset" @bind:after="ChangeInstrumentsAsync" disabled="@busy">
					@foreach (var preset in MelodicPresets) { <option value="@(preset.Bank * 128 + preset.Program)">@preset.Name (@preset.Bank:@preset.Program)</option> }
				</select></label>
				<label>Bass <select @bind="bassPreset" @bind:after="ChangeInstrumentsAsync" disabled="@busy">
					@foreach (var preset in MelodicPresets) { <option value="@(preset.Bank * 128 + preset.Program)">@preset.Name (@preset.Bank:@preset.Program)</option> }
				</select></label>
				<label>Melody <select @bind="melodyPreset" @bind:after="ChangeInstrumentsAsync" disabled="@busy">
					@foreach (var preset in MelodicPresets) { <option value="@(preset.Bank * 128 + preset.Program)">@preset.Name (@preset.Bank:@preset.Program)</option> }
				</select></label>
				<label>Drum kit <select @bind="drumPreset" @bind:after="ChangeInstrumentsAsync" disabled="@busy">
					@foreach (var preset in DrumPresets) { <option value="@(preset.Bank * 128 + preset.Program)">@preset.Name (@preset.Bank:@preset.Program)</option> }
				</select></label>
			</div>
			<p class="note">Loaded bank: @soundFontName. Instrument changes re-render the current score.</p>
		}
	}
	@if (busy)
	{
		<div role="status" aria-live="polite">
			<p><strong>@busyMessage</strong></p>
			<progress aria-label="@busyMessage"></progress>
		</div>
	}
	@if (error is not null)
	{
		<p style="color:var(--bad)">@error</p>
	}
</div>

@if (song is not null)
{
	<p class="note" style="margin-top:1rem">Rendered @song.Duration.TotalSeconds.ToString("0") s of audio at @song.SampleRate.ToString("N0") Hz in @renderSeconds.ToString("0.0") s, in your browser. @RenderDescription</p>
	@if (soundMode == "soundfont" && soundFontResult is not null)
	{
		<details><summary>SoundFont rendering details</summary><pre>@System.Text.Json.JsonSerializer.Serialize(soundFontResult.Metadata, SoundFontJsonContext.Default.SoundFontRenderMetadata)</pre></details>
	}
	<div class="grid" style="margin-top:1rem">
		<div class="card"><div class="stat">@song.Info.TempoBpm</div><p>beats per minute (one beat lasts @((60.0 / song.Info.TempoBpm).ToString("0.000")) s)</p></div>
		<div class="card"><div class="stat">@Pitch.NameOf(song.Info.RootMidi)</div><p>root note, @song.Info.ScaleName scale</p></div>
		<div class="card"><div class="stat">@song.Info.DetuneCents</div><p>cents from concert pitch (A4 = @song.Info.ReferenceHz.ToString("0.0") Hz)</p></div>
		<div class="card"><div class="stat">@song.Notes.Count</div><p>notes and drum hits</p></div>
	</div>

	@if (audioUrl is not null)
	{
		<div class="control-row">
			<label>Visualizer
				<select @bind="visualizer" disabled="@busy">
					<option value="piano">Piano roll</option>
					<option value="spectrogram">Spectrogram</option>
				</select>
			</label>
		</div>
		<MusicPlayer Src="@audioUrl" Notes="song.Notes" Sections="song.Sections" ShowSpectrogram="ShowSpectrogram" />
	}
	@if (song.Sections.Count > 0)
	{
		<p class="note">A and B identify returning material. Register, density and voice choices can change its performance. The comparison mode keeps the same opening, section lengths, key and tempo, then introduces new material on each later return. Short requests keep only the sections that fit.</p>
		<div class="table-scroll"><table aria-label="Section timeline">
			<thead><tr><th>Section</th><th>Material</th><th>Start (s)</th><th>End (s)</th><th>Bars</th><th>Planned phrases</th><th>Bars / phrase</th><th>Ending</th></tr></thead>
			<tbody>
				@foreach (var section in song.Sections)
				{
					<tr><td>@section.Kind</td><td>@section.MaterialId</td><td>@section.StartSeconds.ToString("0.00")</td><td>@section.EndSeconds.ToString("0.00")</td><td>@section.Bars</td><td>@section.PhraseCount</td><td>@section.PhraseBars</td><td>@(section.IsTruncated ? "Cropped" : section.HasCadence ? "Tonic cadence" : section.HasTransitionFill ? "Drum fill" : "Transition")</td></tr>
				}
			</tbody>
		</table></div>
	}

	<p class="note">Mute and solo remix the captured stems without generating new notes. Each part has independent random choices; removing one leaves the other parts unchanged. The original mix gain is retained, so soloing does not make a quiet track louder.</p>
	<details><summary>Notes for the audible tracks (@song.Notes.Count)</summary>
		<div class="table-scroll"><table><thead><tr><th>Voice</th><th>Start (s)</th><th>Length (s)</th><th>Pitch</th></tr></thead><tbody>
			@foreach (var n in song.Notes)
			{
				<tr><td>@n.Voice</td><td>@n.StartSeconds.ToString("0.00")</td><td>@n.DurationSeconds.ToString("0.00")</td><td>@Pitch.NameOf(n.MidiNote)</td></tr>
			}
		</tbody></table></div>
	</details>
	@if (!ShowSpectrogram)
	{
		<p class="note">
			<span style="color:#9b8cff">&#9632;</span> pad &nbsp; <span style="color:#4cc2ff">&#9632;</span> bass &nbsp; <span style="color:#7cf0b2">&#9632;</span> melody &nbsp;
			<span style="color:#ff8f6b">&#9632;</span> kick &nbsp; <span style="color:#ffd666">&#9632;</span> snare &nbsp; <span style="color:#c9d3ea">&#9632;</span> hi-hat.
			Horizontal axis: time. Vertical axis: pitch, one row per semitone, with each C labelled.
		</p>
	}
}

<h2>How the procedural instruments are made</h2>
<div class="steps">
	<div class="step"><strong>Pad.</strong> One chord per bar: a triad (scale degrees 0, 2 and 4 above a random degree) on the octave above the bass, optionally inverted by lifting the lowest notes one octave.
		Folded below the melody, with two soft harmonics, amplitude 0.04 and a 0.12 s attack.</div>
	<div class="step"><strong>Bass.</strong> On each beat there is a 65% chance of a bass note, usually the chord's root and sometimes its fifth (7 semitones up).
		Low (the key's root sits between C2 and B2), few harmonics, quick decay.</div>
	<div class="step"><strong>Melody.</strong> A random walk: after each note the scale degree moves by &minus;3 to +3 steps, clamped to the chosen range, with note lengths of half, one or one and a half beats and a 15% chance of a rest.
		Six harmonics and gentle frequency modulation: f&prime; = f (1 + d sin(2&pi; v t)), with v between 4.5 and 6.5 Hz.
		Depth d rises from zero after a 0.15 s delay to 0.0012 over 0.2 s; notes shorter than a third of a second have no vibrato. The oscillator integrates frequency to keep phase continuous.</div>
	<div class="step"><strong>Kick.</strong> A single sine whose frequency falls quickly, f(t) = f<sub>0</sub> + 110 e<sup>&minus;28t</sup>, with amplitude 0.5 e<sup>&minus;14t</sup>: the thump of a drum skin relaxing.</div>
	<div class="step"><strong>Snare and hi-hat.</strong> White noise passed through a first-difference filter, y<sub>n</sub> = w<sub>n</sub> &minus; w<sub>n&minus;1</sub>, which cuts the low frequencies,
		times a fast decay e<sup>&minus;6u</sup> over the burst. The snare is longer and louder than the hat.</div>
	<div class="step"><strong>Envelope.</strong> Every tone is multiplied by attack &times; decay &times; release: a 1/120 s linear rise (0.12 s for the pad) (so there is no click), an exponential decay e<sup>&minus;d&middot;t/length</sup>, and a 1/40 s fade at the end.</div>
	<div class="step"><strong>Mixing.</strong> The parts are summed and the whole song is scaled so that its loudest sample is exactly 0.9.</div>
</div>

@code {
	[SupplyParameterFromQuery(Name = "form")]
	public string? FormMode { get; set; } = "free";
	private IJSObjectReference? module;
	private string seedText = "42";
	private int seconds = 60;
	private double renderSeconds;
	private readonly HashSet<VoiceKind> muted = [];
	private VoiceKind? solo;
	private GeneratedSong? sourceSong;
	private int melodyLow = 48;
	private int melodySpan = 24;
	private GeneratedSong? song;
	private string? audioUrl;
	private string? error;
	private bool busy;
	private string visualizer = "piano";
	private bool ShowSpectrogram => visualizer == "spectrogram";
	private string? busyMessage;

	private async Task<IJSObjectReference> ModuleAsync() => module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/music.js");

	private async Task RandomSeedAsync()
	{
		seedText = Random.Shared.Next(1, 99999).ToString(System.Globalization.CultureInfo.InvariantCulture);
		await GenerateAsync();
	}

	private async Task GenerateAsync()
	{
		if (busy)
		{
			return;
		}

		error = null;
		if (!int.TryParse(seedText, out var seed))
		{
			error = "The seed must be a whole number.";
			return;
		}

		busy = true;
		try
		{
			await ShowProgressAsync($"Generating {seconds} seconds of music…");
			const int rate = 11025;
			var clock = System.Diagnostics.Stopwatch.StartNew();
			var style = new SongStyle { UsePlatformSine = true, MelodyLowMidi = melodyLow, MelodyHighMidi = melodyLow + melodySpan, Form = ChosenForm() };
			proceduralSong = SongGenerator.GenerateStems(seed, seconds, rate, style);
			soundFontResult = null;
			await PrepareSoundAsync();
			renderSeconds = clock.Elapsed.TotalSeconds;
			await ShowProgressAsync("Preparing audio and player…");
			await RemixAsync();
		}
		catch (Exception ex) when (IsRenderError(ex))
		{
			error = ex.Message;
		}
		finally
		{
			busy = false;
			busyMessage = null;
			StateHasChanged();
		}
	}

	private Task ToggleMuteAsync(VoiceKind voice) => UpdateTracksAsync(() =>
	{
		if (!muted.Add(voice))
		{
			muted.Remove(voice);
		}
	});

	private Task ToggleSoloAsync(VoiceKind voice) => UpdateTracksAsync(() => solo = solo == voice ? null : voice);

	private async Task UpdateTracksAsync(Action update)
	{
		if (busy)
		{
			return;
		}
		busy = true;
		try
		{
			await ShowProgressAsync("Updating the mix…");
			update();
			await RemixAsync();
		}
		finally
		{
			busy = false;
			busyMessage = null;
		}
	}

	private async Task ShowProgressAsync(string message)
	{
		busyMessage = message;
		StateHasChanged();
		var js = await ModuleAsync();
		await js.InvokeVoidAsync("nextPaint");
	}

	private async Task RemixAsync()
	{
		if (sourceSong is null)
		{
			return;
		}
		var active = Enum.GetValues<VoiceKind>().Where(v => solo is { } selected ? v == selected : !muted.Contains(v)).ToHashSet();
		var samples = new float[sourceSong.Samples.Length];
		for (var i = 0; i < samples.Length; i++)
		{
			var sum = 0.0;
			foreach (var voice in active)
			{
				sum += sourceSong.Stems[voice][i];
			}
			samples[i] = (float)(sum * sourceSong.NormalisationGain);
		}
		song = sourceSong with { Samples = samples, Notes = sourceSong.Notes.Where(n => active.Contains(n.Voice)).ToArray() };
		var js = await ModuleAsync();
		var previousUrl = audioUrl;
		audioUrl = await js.InvokeAsync<string>("createAudioUrl", song.ToWav());
		if (previousUrl is not null)
		{
			await js.InvokeVoidAsync("revokeAudioUrl", previousUrl);
		}
	}

	private void ChooseForm()
	{
		if (FormMode is "sections" or "through")
		{
			seconds = Math.Max(seconds, 60);
		}
	}

	private SongForm? ChosenForm()
	{
		if (FormMode is not ("sections" or "through"))
		{
			return null;
		}
		var form = SongForms.VerseChorus;
		return FormMode == "sections" ? form : form with
		{
			Sections = form.Sections.Select((s, i) => i < 3 ? s : s with { MaterialId = $"{s.MaterialId}-{i}" }).ToArray()
		};
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			soundMode = SoundMode == "soundfont" ? "soundfont" : "procedural";
			ChooseForm();
			await GenerateAsync();
		}
	}

	public async ValueTask DisposeAsync()
	{
		await renderCancellation.CancelAsync();
		renderCancellation.Dispose();
		if (module is not null)
		{
			if (audioUrl is not null)
			{
				await module.InvokeVoidAsync("revokeAudioUrl", audioUrl);
			}
			await module.DisposeAsync();
		}
	}
}
