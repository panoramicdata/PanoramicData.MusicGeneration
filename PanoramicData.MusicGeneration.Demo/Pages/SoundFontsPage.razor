@page "/soundfonts"
@implements IAsyncDisposable
@inject SoundFontBankService Banks
@inject IJSRuntime JS
@using PanoramicData.MusicGeneration.SoundFonts

<h1>SoundFonts and expression</h1>
<p class="lead">A written note chooses a pitch and a time. A SoundFont supplies the instrument: recorded samples, loop points, envelopes and the way playing strength changes the sound.</p>

<div class="grid">
	<div class="card"><h2>1. From note to instrument</h2><p>An SF2 bank groups samples into presets such as piano, violin and flute. The same notes can be played by different instruments. The bank handles sample choice, tuning, filtering and release.</p><p>This lesson uses GeneralUser GS by S. Christian Collins. <a href="soundfonts/GeneralUser-GS-LICENSE.txt">Bank licence</a> · <a href="soundfonts/MeltySynth-LICENSE.txt">Renderer licence</a>.</p></div>
	<div class="card"><h2>2. Strength and attack</h2><p>MIDI velocity describes playing strength, rather than changing the song's speed. A harder strike can select a brighter sample as well as making it louder. Attack time describes how quickly the sound rises after the note begins.</p><p>The keyboard demonstrates both: near the top is soft and slower; near the bottom is hard and faster. The added attack ramp is separate from the instrument's own recorded envelope.</p></div>
</div>

<section class="card keyboard-lesson" aria-label="Interactive SoundFont keyboard">
	<h2>3. Try it</h2>
	@if (renderer is null)
	{
		<button @onclick="LoadAsync" disabled="@busy">@(busy ? "Loading instruments…" : "Load instruments and enable sound")</button>
		<p class="note">First use loads a 30.8 MiB bank. Playing stays in this browser.</p>
	}
	else
	{
		<div class="control-row"><label>Instrument <select @bind="program" disabled="@busy">
			@foreach (var preset in renderer.Presets.Where(p => p.Bank == 0)) { <option value="@preset.Program">@preset.Name</option> }
		</select></label></div>
		<p><strong>Top of key: soft / slow attack.</strong> <span class="note">Bottom: hard / fast attack. Touch and mouse use the same position mapping.</span></p>
		<div class="keyboard-scroll"><div @ref="keyboardElement" class="keyboard" role="group" aria-label="Two-octave keyboard, C3 to B4">
			@foreach (var key in Keys)
			{
				<button id="@($"soundfont-key-{key.Midi}")" class="@(key.Black ? "piano-key black" : "piano-key white")" style="left:@(key.Left.ToString(System.Globalization.CultureInfo.InvariantCulture))%"
					data-midi="@key.Midi" aria-label="Play @Pitch.NameOf(key.Midi)">
					<span>@Pitch.NameOf(key.Midi)</span>
				</button>
			}
		</div></div>
		<div aria-live="polite" class="playing-readout"><strong>@lastNote</strong> · velocity @velocity / 127 · added attack @attackMilliseconds.ToString("0") ms</div>
		<svg viewBox="0 0 400 95" class="envelope" role="img" aria-label="Envelope showing the selected attack speed">
			<line x1="20" y1="75" x2="390" y2="75" stroke="currentColor" />
			<polyline points="20,75 @(20 + attackMilliseconds),15 220,35 330,35 385,75" fill="none" stroke="#4cc2ff" stroke-width="3" />
			<text x="25" y="92" fill="currentColor">note on</text><text x="300" y="92" fill="currentColor">release</text>
		</svg>
		<p class="note">Hold a key with mouse or touch; releasing it starts the instrument’s release. Hold Space or Enter on a focused key for medium strength. Several notes can overlap. Piano strings decay while held; lifting the key applies the damper. This is a sample-based lesson, not a measurement of your keyboard's physical strike speed.</p>
	}
	@if (error is not null) { <p role="alert">@error</p> }
</section>

<h2>4. What makes a convincing part?</h2>
<p>Instrument samples help with timbre, but musical choices still matter: chord direction, memorable motifs, rests, articulation, dynamics and parts that leave room for each other. A bank alone does not turn random notes into an arrangement.</p>
<p><a class="button" href="song">Build an arrangement with these instruments</a></p>

<SyntheticInstrumentLab />

@code {
	private SoundFontRenderer? renderer;
	private IJSObjectReference? module;
	private bool busy;
	private int program;
	private ElementReference keyboardElement;
	private string lastNote = "Choose a note";
	private int velocity = 80;
	private double attackMilliseconds = 45;
	private string? error;
	private readonly Dictionary<string, SoundFontKeyboardVoice> voices = [];
	private IJSObjectReference? keyboard;
	private DotNetObjectReference<SoundFontsPage>? callbacks;
	private bool disposed;
	private bool connecting;
	private static readonly IReadOnlyList<PianoKey> Keys = BuildKeys();
	private sealed record PianoKey(int Midi, bool Black, double Left);

	private async Task LoadAsync()
	{
		busy = true;
		error = null;
		try
		{
			module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboard.js");
			await module.InvokeVoidAsync("enableKeyboardAudio");
			renderer = await Banks.GetAsync();
		}
		catch (Exception ex) when (ex is HttpRequestException or IOException or JSException) { error = ex.Message; }
		finally { busy = false; }
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (renderer is null || module is null || keyboard is not null || connecting || disposed) { return; }
		connecting = true;
		callbacks = DotNetObjectReference.Create(this);
		keyboard = await module.InvokeAsync<IJSObjectReference>("createKeyboard", keyboardElement, callbacks);
	}

	[JSInvokable]
	public async Task<bool> StartKeyboardVoice(string id, int midi, double position)
	{
		if (renderer is null || disposed || voices.Count >= 24) { return false; }
		position = Math.Clamp(position, 0, 1);
		velocity = Math.Clamp((int)Math.Round((35 + position * 92) / 16.0) * 16, 1, 127);
		attackMilliseconds = 150 * (1 - position) + 2;
		lastNote = Pitch.NameOf(midi);
		voices[id] = renderer.CreateKeyboardVoice(program, midi, velocity);
		await InvokeAsync(StateHasChanged);
		return true;
	}

	[JSInvokable]
	public byte[] RenderKeyboardVoice(string id, bool released)
	{
		if (disposed || !voices.TryGetValue(id, out var voice)) { return []; }
		if (released) { voice.Release(); }
		var samples = voice.Render(882);
		var bytes = new byte[samples.Length * sizeof(float)];
		Buffer.BlockCopy(samples, 0, bytes, 0, bytes.Length);
		return bytes;
	}

	[JSInvokable]
	public void StopKeyboardVoice(string id) => voices.Remove(id);

	[JSInvokable]
	public Task KeyboardError(string message)
	{
		error = message;
		return InvokeAsync(StateHasChanged);
	}

	private static IReadOnlyList<PianoKey> BuildKeys()
	{
		var result = new List<PianoKey>();
		var white = 0;
		for (var midi = 48; midi < 72; midi++)
		{
			var black = new[] { 1, 3, 6, 8, 10 }.Contains(midi % 12);
			result.Add(new(midi, black, (black ? white - 0.32 : white) * 100.0 / 14));
			if (!black) { white++; }
		}
		return result;
	}

	public async ValueTask DisposeAsync()
	{
		disposed = true;
		if (keyboard is not null) { await keyboard.InvokeVoidAsync("dispose"); await keyboard.DisposeAsync(); }
		voices.Clear();
		callbacks?.Dispose();
		if (module is not null) { await module.DisposeAsync(); }
	}
}
