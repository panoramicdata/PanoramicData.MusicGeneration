<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<NeutralResourcesLanguage>en</NeutralResourcesLanguage>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<RootNamespace>PanoramicData.MusicGeneration.Demo</RootNamespace>
		<!-- Razor markup compiles to generated code that trips style analyzers; CA2007 does not apply to UI code. -->
		<NoWarn>$(NoWarn);CA2007;CA1812</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseLocalBlazor)' == 'true'">
		<DefineConstants>$(DefineConstants);LOCAL_BLAZOR</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="'$(UseLocalBlazor)' == 'true'">
		<ProjectReference Include="..\..\PanoramicData.Blazor\PanoramicData.Blazor\PanoramicData.Blazor.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalBlazor)' != 'true'">
		<PackageReference Include="PanoramicData.Blazor" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PanoramicData.MusicGeneration\PanoramicData.MusicGeneration.csproj" />
	</ItemGroup>

</Project>
