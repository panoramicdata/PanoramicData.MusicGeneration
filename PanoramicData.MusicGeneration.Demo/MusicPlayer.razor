@using PanoramicData.Blazor
@using PanoramicData.Blazor.Models

<PDMediaPlayer Src="@Src" Title="Generated audio" Segments="MediaSections" ShowSegmentList="false"
	ShowSpectrogram="@ShowSpectrogram" SpectrogramHeight="360" ShowNotes="@(!ShowSpectrogram)"
	Notes="MediaNotes" NotesHeight="360" ShowNoteSegments="true" />

@code {
	[Parameter] public string? Src { get; set; }
	[Parameter] public IReadOnlyList<NoteEvent> Notes { get; set; } = [];
	[Parameter] public IReadOnlyList<SectionEvent> Sections { get; set; } = [];
	[Parameter] public bool ShowSpectrogram { get; set; }
	[Parameter] public IReadOnlyList<ChordEvent> Chords { get; set; } = [];
	[Parameter] public IReadOnlyDictionary<string, string>? LayerNames { get; set; }

	private IReadOnlyList<PDMediaSegment> MediaSections => Sections.Select(s => new PDMediaSegment
	{
		Id = $"section-{s.Index}", Start = TimeSpan.FromSeconds(s.StartSeconds), End = TimeSpan.FromSeconds(s.EndSeconds),
		Kind = s.Kind.ToString(), Label = $"{s.Kind}: {s.MaterialId}{(s.IsTruncated ? " (cropped)" : string.Empty)}",
		Detail = DescribePhrases(s)
	}).Concat(Chords.Select((c, i) => new PDMediaSegment
	{
		Id = $"chord-{i}", Start = TimeSpan.FromSeconds(c.StartSeconds), End = TimeSpan.FromSeconds(c.EndSeconds),
		Kind = "Chord", Label = c.Symbol, Detail = string.Join(" · ", c.Intervals.Select(n => Pitch.NameOf(48 + c.Root + n)))
	})).ToArray();

	private static string DescribePhrases(SectionEvent section)
	{
		var phrase = section.PhraseCount == 1 ? "phrase" : "phrases";
		var bar = section.PhraseBars == 1 ? "bar" : "bars";
		return $"{(section.IsTruncated ? "Planned " : string.Empty)}{section.PhraseCount} {phrase} × {section.PhraseBars} {bar}";
	}

	private IReadOnlyList<PDMediaNote> MediaNotes => Notes.Select(n => new PDMediaNote
	{
		Start = TimeSpan.FromSeconds(n.StartSeconds), Duration = TimeSpan.FromSeconds(n.DurationSeconds),
		MidiNote = n.MidiNote, Voice = VoiceName(n), Label = Pitch.NameOf(n.MidiNote), Color = Colours[(int)n.Voice]
	}).ToArray();

	private string VoiceName(NoteEvent note) => note.LayerId is not null && LayerNames?.TryGetValue(note.LayerId, out var name) == true ? name : note.Voice.ToString();

	private static readonly string[] Colours = ["#9b8cff", "#4cc2ff", "#7cf0b2", "#ff8f6b", "#ffd666", "#c9d3ea"];
}
