<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Exe</OutputType>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<NeutralResourcesLanguage>en</NeutralResourcesLanguage>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- CA2007: xUnit tests must not use ConfigureAwait(false) (xUnit1030). CA1707: test names use underscores. -->
		<NoWarn>$(NoWarn);CA2007;CA1707</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" />
		<PackageReference Include="AwesomeAssertions.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
		<PackageReference Include="xunit.v3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PanoramicData.MusicGeneration\PanoramicData.MusicGeneration.csproj" />
		<ProjectReference Include="..\PanoramicData.MusicGeneration.SoundFonts\PanoramicData.MusicGeneration.SoundFonts.csproj" />
		<Content Include="..\PanoramicData.MusicGeneration.Demo\wwwroot\soundfonts\GeneralUser-GS.sf2" Link="TestAssets\GeneralUser-GS.sf2" CopyToOutputDirectory="PreserveNewest" />
		<!-- Exercise the demo's actual source-generated JSON contract without a WebAssembly project dependency. -->
		<Compile Include="..\PanoramicData.MusicGeneration.Demo\Pages\StudioModels.cs" Link="DemoContract\StudioModels.cs" />
		<Compile Include="..\PanoramicData.MusicGeneration.Demo\Pages\StudioDocumentMigration.cs" Link="DemoContract\StudioDocumentMigration.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="AwesomeAssertions" />
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
